{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Triage Receipt",
  "description": "Extension fields for triage-receipt.json in .wabblespec/receipts/",
  "type": "object",
  "required": ["issue_id", "severity", "type", "recurrence_count", "route_to", "escalated"],
  "properties": {
    "issue_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "type": {
      "type": "string",
      "enum": ["bug", "feature", "debt", "question", "security"]
    },
    "recurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "route_to": {
      "type": "string"
    },
    "escalated": {
      "type": "boolean"
    },
    "synth_triggered": {
      "type": "boolean"
    },
    "triage_record_drawer": {
      "type": "string",
      "description": "Memory drawer ID where triage record was written"
    }
  }
}
