{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provenance Record",
  "description": "Lineage record for one drawer. Stored in provenance/index.json keyed by drawer_id.",
  "type": "object",
  "required": [
    "drawer_id", "topic", "source", "written_by", "written_at",
    "confidence", "staleness_state", "cited_by", "contradiction_with", "deletion"
  ],
  "properties": {
    "drawer_id": { "type": "string" },
    "topic": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["path", "type", "trust_level"],
      "properties": {
        "path": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["framework-reference", "project-file", "external-doc", "internal-computation"]
        },
        "trust_level": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"]
        }
      }
    },
    "written_by": { "type": "string", "description": "Module ID." },
    "written_at": { "type": "string", "format": "date-time" },
    "last_updated": { "type": ["string", "null"], "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "staleness_state": {
      "type": "string",
      "enum": ["FRESH", "AGING", "STALE", "EXPIRED", "NEEDS_REVERIFICATION", "SUPERSEDED"]
    },
    "last_verified": { "type": ["string", "null"], "format": "date-time" },
    "superseded_by": { "type": ["string", "null"] },
    "cited_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Spec artifact paths that reference this drawer."
    },
    "contradiction_with": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Drawer IDs this record contradicts."
    },
    "deletion": {
      "type": "object",
      "required": ["deleted"],
      "properties": {
        "deleted": { "type": "boolean" },
        "deleted_at": { "type": ["string", "null"], "format": "date-time" },
        "deleted_by": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "archived_to": { "type": ["string", "null"] }
      }
    }
  }
}
