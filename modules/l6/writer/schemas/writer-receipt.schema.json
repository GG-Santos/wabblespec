{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "writer-receipt.schema.json",
  "title": "WriterReceipt",
  "allOf": [{ "$ref": "../../../_shared/schemas/receipt.base.schema.json" }],
  "properties": {
    "content_type": {
      "type": "string",
      "enum": ["landing-page", "blog-post", "technical-article", "case-study", "tutorial", "awareness"]
    },
    "goal": { "type": "string" },
    "audience": {
      "type": "string",
      "enum": ["developer", "business", "end-user", "executive", "technical-buyer"]
    },
    "structure_applied": { "type": "string" },
    "word_count": { "type": "integer", "minimum": 0 },
    "word_count_target": { "type": ["integer", "null"] },
    "key_points_covered": { "type": "array", "items": { "type": "string" } },
    "key_points_missing": { "type": "array", "items": { "type": "string" } },
    "output_path": { "type": "string" },
    "verdict": { "enum": ["PASS", "WARN"] },
    "written_at": { "type": "string", "format": "date-time" }
  },
  "required": ["content_type", "goal", "audience", "structure_applied", "word_count", "key_points_covered", "key_points_missing", "output_path", "verdict", "written_at"]
}
