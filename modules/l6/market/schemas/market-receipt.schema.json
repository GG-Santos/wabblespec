{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "market-receipt.schema.json",
  "title": "MarketReceipt",
  "allOf": [{ "$ref": "../../../_shared/schemas/receipt.base.schema.json" }],
  "properties": {
    "mode": { "enum": ["positioning", "messaging", "execution", "full"] },
    "product_name": { "type": "string" },
    "positioning_brief_path": { "type": ["string", "null"] },
    "message_hierarchy_path": { "type": ["string", "null"] },
    "execution_plan_path": { "type": ["string", "null"] },
    "icp_defined": { "type": "boolean" },
    "market_category": { "type": "string" },
    "primary_message": { "type": ["string", "null"] },
    "channels_recommended": { "type": "array", "items": { "type": "string" } },
    "assumptions_made": { "type": "array", "items": { "type": "string" } },
    "verdict": { "enum": ["PASS", "WARN"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["mode", "product_name", "icp_defined", "market_category", "channels_recommended", "assumptions_made", "verdict", "created_at"]
}
