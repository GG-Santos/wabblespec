{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "legal-receipt.schema.json",
  "title": "LegalReceipt",
  "allOf": [{ "$ref": "../../../_shared/schemas/receipt.base.schema.json" }],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["privacy-policy", "terms-of-service", "gdpr-data-processing", "disclaimer"]
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["gdpr", "ccpa", "pipeda", "multi"]
    },
    "template_used": { "type": "string" },
    "output_path": { "type": "string" },
    "clauses_populated": { "type": "array", "items": { "type": "string" } },
    "clauses_requiring_review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause", "reason"],
        "properties": {
          "clause": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "legal_review_required": { "type": "boolean", "const": true },
    "verdict": { "enum": ["DRAFT"] },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["document_type", "jurisdiction", "template_used", "output_path", "clauses_populated", "clauses_requiring_review", "legal_review_required", "verdict", "generated_at"]
}
