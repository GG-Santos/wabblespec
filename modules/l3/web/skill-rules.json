{
  "layer": "L3",
  "invariants": [
    "Web platform only activates when Recipe has identified a browser-targeted frontend",
    "SSR/SSG concerns (hydration, routing strategy) must be declared when Next.js or SvelteKit detected",
    "Browser support matrix must be declared before Specify receipt is written",
    "Accessibility gate (axe-core) is non-optional for all Web targets"
  ],
  "produces": [
    "platform-activation-receipt"
  ],
  "loads": [
    "spec-template/design-document.md",
    "spec-template/systems-design.md",
    "spec-template/technical-spec.md",
    "engineering/build-toolchain.md",
    "engineering/performance-budgets.md",
    "security/threat-model.md",
    "security/platform-controls.md",
    "verification/gates.md"
  ],
  "routes_to_language_modules": [
    "_shared/dev/languages/node"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [
    "**/src/**/*.tsx",
    "**/src/**/*.vue",
    "**/src/**/*.svelte",
    "**/*.html",
    "**/*.tsx",
    "**/*.jsx",
    "**/*.vue",
    "**/*.svelte",
    "**/next.config.*",
    "**/vite.config.*"
  ],
  "module": "web",
  "activators": [
    "web app",
    "frontend",
    "browser app",
    "react app",
    "next.js",
    "vue app",
    "svelte app",
    "landing page",
    "dashboard",
    "SPA",
    "SSR"
  ],
  "anti_activators": [
    "cli.py",
    "__main__.py",
    "cmd/",
    "server.ts with no frontend",
    "Dockerfile with EXPOSE and no static output"
  ],
  "tier": 2,
  "build_targets": [
    "WEB"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/web-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/",
      ".wabblespec/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
