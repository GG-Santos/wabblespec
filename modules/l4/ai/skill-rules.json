{
  "layer": "L4",
  "invariants": [
    "Gateway activates only after L3 platform package has written its activation receipt",
    "Gateway gates supplement platform gates — they do not replace them",
    "Model version must be pinned before gateway receipt can be PASS",
    "Eval suite must pass declared thresholds before any model or prompt version bump proceeds",
    "All agent tools with side_effects:true and reversible:false require attestation_required:true",
    "No LLM output directly executed or rendered without a declared validator"
  ],
  "produces": [
    "gateway-ai-receipt"
  ],
  "loads": [
    "prompt-engineering.md",
    "chain-design.md",
    "agent-architecture.md",
    "evaluation.md",
    "safety.md",
    "model-pinning.md",
    "eval-policy.md",
    "audit-gates.md"
  ],
  "supplements": [
    "modules/l3/cli/",
    "modules/l3/web/",
    "modules/l3/api-service/",
    "modules/l3/ai-agent/"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [],
  "module": "ai",
  "activators": [
    "LLM",
    "AI feature",
    "language model",
    "prompt engineering",
    "agent",
    "chain",
    "model version",
    "eval suite",
    "token budget",
    "model pinning",
    "AI/Agent target",
    "/ai"
  ],
  "anti_activators": [],
  "tier": 2,
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/ai-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/",
      ".wabblespec/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
