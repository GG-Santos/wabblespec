{
  "layer": "L4",
  "invariants": [
    "Gateway activates only after L3 platform package has written its activation receipt",
    "Gateway gates supplement platform gates — they do not replace them",
    "SAST tool must be identified before audit-gates.md is registered with Verifier",
    "Git history scan must cover full repo history, not just current HEAD"
  ],
  "produces": [
    "gateway-security-receipt"
  ],
  "loads": [
    "threat-model.md",
    "vulnerability-patterns.md",
    "controls.md",
    "audit-gates.md"
  ],
  "supplements": [
    "modules/l3/cli/security/",
    "modules/l3/web/security/",
    "modules/l3/api-service/security/"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [],
  "module": "security",
  "activators": [
    "security review",
    "security audit",
    "threat model",
    "payments",
    "PII",
    "personal data",
    "authentication system",
    "authorization system",
    "cryptography",
    "secrets management",
    "HIPAA",
    "SOC 2",
    "GDPR"
  ],
  "anti_activators": [],
  "tier": 2,
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/security-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/",
      ".wabblespec/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
