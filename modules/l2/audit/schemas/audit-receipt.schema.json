{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Receipt Extension",
  "description": "Extends receipt.base.schema.json. Module-specific fields for the Audit module.",
  "allOf": [
    { "$ref": "../../../_shared/schemas/receipt.base.schema.json" }
  ],
  "properties": {
    "dimensions_checked": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Audit dimensions checked. e.g. [wcag-aa, gdpr, license-compliance, guard-log-review]"
    },
    "wcag_level_achieved": {
      "type": "string",
      "enum": ["AA", "AAA", "PARTIAL", "FAIL", "not-applicable"],
      "description": "WCAG accessibility outcome."
    },
    "guard_logs_consumed": {
      "type": "boolean",
      "description": "True if Guard operation logs were read and processed."
    },
    "guard_log_violations_found": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of Guard log entries classified as policy violations."
    },
    "total_violations": {
      "type": "integer",
      "minimum": 0,
      "description": "Total violations across all dimensions."
    },
    "violations_by_dimension": {
      "type": "object",
      "properties": {
        "wcag": { "type": "integer", "minimum": 0 },
        "gdpr": { "type": "integer", "minimum": 0 },
        "license": { "type": "integer", "minimum": 0 },
        "guard-log": { "type": "integer", "minimum": 0 }
      },
      "required": ["wcag", "gdpr", "license", "guard-log"]
    },
    "compliance_report_path": {
      "type": "string",
      "description": "Path to compliance report. e.g. .wabblespec/audits/compliance-<timestamp>.md"
    },
    "attestation_required": {
      "type": "boolean",
      "description": "True if violations require human sign-off before this audit can approve a release."
    }
  },
  "required": [
    "dimensions_checked",
    "wcag_level_achieved",
    "guard_logs_consumed",
    "guard_log_violations_found",
    "total_violations",
    "violations_by_dimension",
    "compliance_report_path",
    "attestation_required"
  ]
}
