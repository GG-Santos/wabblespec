{
  "module": "inference-guard",
  "layer": "L2",
  "tier": 2,
  "activators": [
    "gateway-security active",
    "task_type is security or pentest or red-team or vulnerability-analysis or threat-model or security-audit",
    "inference guard needed",
    "false refusal prevention"
  ],
  "anti_activators": [
    "inference_guard: false in task card",
    "no security gateway active",
    "general code-generation task",
    "spec authoring task",
    "planning task",
    "documentation task"
  ],
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "Execute"
  ],
  "stages": [
    "ALL"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/inference-guard-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/task-card.md",
      "_shared/scripts/inference-guard.py",
      "modules/l2/inference-guard/rules/activation-policy.md",
      "modules/l2/inference-guard/rules/trigger-vocabulary.md"
    ]
  },
  "verification_mode": "Observation",
  "receipt_required": true,
  "collapse_eligible": false,
  "gate_collapsing_conditions": null,
  "invariants": [
    "Never activates outside gateway-security context or security-typed task",
    "Tier 3 triggers require explicit inference_guard_tier: heavy in task card",
    "Excluded terms (nsfw, jailbreak, roleplay) are never triggers",
    "Receipt is written on every execution — activation or not (I10)",
    "No model names in output (I6)"
  ],
  "requires_receipts_from": [],
  "loading_gate": "phase",
  "tags": ["security", "enforcement", "gate", "inference"],
  "produces_schemas": ["modules/l2/inference-guard/schemas/receipt.schema.json"],
  "depends_on": ["gateway-security"],
  "commands": ["/inference-guard"],
  "file_path_patterns": []
}
