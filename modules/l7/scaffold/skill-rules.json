{
  "module": "scaffold",
  "layer": "L7",
  "tier": 1,
  "activators": [
    "scaffold project",
    "create new project",
    "initialize project",
    "generate project structure",
    "start new project",
    "new project",
    "/scaffold"
  ],
  "anti_activators": [
    "project-map.md exists",
    "project already exists",
    "adding feature to existing project",
    "migrating codebase"
  ],
  "preconditions": [
    ".wabblespec/project-map.md does NOT exist"
  ],
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "Setup"
  ],
  "stages": [
    "project-init"
  ],
  "authority": {
    "owns": [
      ".wabblespec/project-map.md",
      ".wabblespec/VERSION",
      ".wabblespec/CHANGELOG.md",
      ".wabblespec/receipts/scaffold-receipt-*.json"
    ],
    "reads": [
      "modules/l3/*/spec-template/"
    ],
    "triggers": [
      "explore"
    ]
  },
  "verification_mode": "Observation",
  "receipt_required": true,
  "collapse_eligible": false,
  "invariants": [
    "Hard refuse if project-map.md already exists \u2014 PROJECT_ALREADY_EXISTS",
    "project-map.md written LAST \u2014 if generation fails mid-way, scaffold can re-run",
    "Explore triggered after generation \u2014 project must be indexed before first use",
    "Runs exactly once per project lifecycle"
  ],
  "produces": [
    "scaffold-receipt",
    "project-map.md",
    "project-structure"
  ],
  "consumed_by": [
    "explore",
    "recipe"
  ],
  "loading_gate": "stage",
  "commands": [
    "/scaffold"
  ],
  "file_path_patterns": []
}
