{
  "layer": "L3",
  "invariants": [
    "Extension platform only activates when Recipe has run and identified Extension/Plugin as primary target",
    "Manifest permission scope must be declared (and minimized) before Specify receipt is written",
    "CSP policy must be declared for browser extensions before any Executor wave begins",
    "verification/gates.md must be registered with Verifier before any Executor wave runs",
    "Platform activation receipt must be written before Specify begins"
  ],
  "produces": [
    "platform-activation-receipt"
  ],
  "loads": [
    "spec-template/design-document.md",
    "spec-template/systems-design.md",
    "spec-template/technical-spec.md",
    "engineering/build-toolchain.md",
    "engineering/performance-budgets.md",
    "security/threat-model.md",
    "security/platform-controls.md",
    "verification/gates.md"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [
    "**/manifest.json",
    "**/background/**",
    "**/content/**",
    "**/popup/**",
    "manifest.json",
    "plugin.xml",
    "src/background.ts",
    "src/content.ts",
    "src/popup.ts",
    "extension/**/*"
  ],
  "module": "extension",
  "activators": [
    "browser extension",
    "chrome extension",
    "firefox extension",
    "edge extension",
    "web extension",
    "vscode extension",
    "vs code plugin",
    "ide plugin",
    "jetbrains plugin",
    "intellij plugin",
    "safari extension",
    "manifest v3",
    "mv3"
  ],
  "anti_activators": [
    "index.html at root without manifest.json",
    "server.ts",
    "bin field in package.json"
  ],
  "tier": 2,
  "build_targets": [
    "EXTENSION"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/extension-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/",
      ".wabblespec/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
