    "evals/**/*",
    "agents/**/*",
    "chains/**/*"
  ],
  "module": "ai-agent",
  "activators": [
    "ai agent",
    "llm integration",
    "autonomous agent",
    "ai workflow",
    "prompt engineering",
    "rag pipeline",
    "retrieval augmented generation",
