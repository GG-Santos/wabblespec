{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flag Receipt Extension",
  "description": "Extends receipt.base.schema.json. Module-specific fields for the Flag module.",
  "allOf": [
    { "$ref": "../../../.wabblespec/engine/shared/schemas/receipt.base.schema.json" }
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["create", "rollout", "audit", "retire"],
      "description": "Operation mode that was invoked."
    },
    "flag_id": {
      "type": "string",
      "description": "Unique flag identifier in kebab-case."
    },
    "previous_state": {
      "type": ["string", "null"],
      "enum": ["DRAFT", "ACTIVE", "ROLLING", "RETIRED", null],
      "description": "Flag state before this operation. Null for mode=create."
    },
    "new_state": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "ROLLING", "RETIRED"],
      "description": "Flag state after this operation."
    },
    "rollout_gate_passed": {
      "type": ["boolean", "null"],
      "description": "True if all rollout gate conditions passed. Null when mode is not rollout."
    },
    "flag_manifest_path": {
      "type": "string",
      "description": "Path to the flag manifest. e.g. .wabblespec/flags/manifest.json"
    }
  },
  "required": [
    "mode",
    "flag_id",
    "previous_state",
    "new_state",
    "flag_manifest_path"
  ]
}
