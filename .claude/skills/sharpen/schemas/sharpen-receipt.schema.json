{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sharpen Receipt Extension",
  "description": "Extends receipt.base.schema.json. Module-specific fields for the Sharpen module.",
  "allOf": [
    { "$ref": "../../../.wabblespec/engine/shared/schemas/receipt.base.schema.json" }
  ],
  "properties": {
    "interpretations_produced": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Number of competing interpretations identified"
    },
    "interpretations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["rank", "description", "confidence"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "description": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      },
      "description": "All interpretations generated, ranked"
    },
    "interpretation_chosen": {
      "type": "string",
      "description": "Description of the selected interpretation (user-confirmed or auto-selected)"
    },
    "user_confirmed": {
      "type": "boolean",
      "description": "true if user explicitly selected; false if auto-selected per threshold rule"
    },
    "broad_resolved": {
      "type": "boolean",
      "description": "Input is no longer broad after Sharpen. Must be true for status = PASS."
    }
  },
  "required": [
    "interpretations_produced",
    "interpretations",
    "interpretation_chosen",
    "user_confirmed",
    "broad_resolved"
  ]
}
