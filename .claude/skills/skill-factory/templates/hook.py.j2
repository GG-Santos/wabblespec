#!/usr/bin/env python3
"""Portable lifecycle hook adapter for {{ skill_name }}."""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path
from typing import Any


def load_rules() -> list[dict[str, Any]]:
    rules_path = Path(__file__).with_name("rules.yaml")
    if not rules_path.exists():
        return []
    return parse_rules_yaml(rules_path.read_text(encoding="utf-8"))


def parse_rules_yaml(text: str) -> list[dict[str, Any]]:
    """Parse the generated rules.yaml subset without external dependencies."""
    rules: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None
    current_condition: dict[str, str] | None = None

    for raw_line in text.splitlines():
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("- name:"):
            current = {"name": _yaml_value(stripped.split(":", 1)[1]), "conditions": []}
            current_condition = None
            rules.append(current)
            continue
        if current is None:
            continue
        if stripped.startswith("enabled:"):
            current["enabled"] = _yaml_value(stripped.split(":", 1)[1]).lower() != "false"
        elif stripped.startswith("event:"):
            current["event"] = _yaml_value(stripped.split(":", 1)[1])
        elif stripped.startswith("action:"):
            current["action"] = _yaml_value(stripped.split(":", 1)[1])
        elif stripped.startswith("message:"):
            current["message"] = _yaml_value(stripped.split(":", 1)[1])
        elif stripped.startswith("- field:"):
            current_condition = {"field": _yaml_value(stripped.split(":", 1)[1])}
            current["conditions"].append(current_condition)
        elif current_condition is not None and stripped.startswith("operator:"):
            current_condition["operator"] = _yaml_value(stripped.split(":", 1)[1])
        elif current_condition is not None and stripped.startswith("pattern:"):
            current_condition["pattern"] = _yaml_value(stripped.split(":", 1)[1])

    return rules


def _yaml_value(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        inner = value[1:-1]
        if value[0] == '"':
            inner = inner.replace("\\\\", "\\").replace('\\"', '"')
        return inner
    return value


def event_name(event: dict[str, Any]) -> str:
    explicit = str(event.get("event") or event.get("hook_event_name") or "").lower()
    if explicit:
        return explicit
    tool_name = str(event.get("tool_name") or "").lower()
    if "bash" in tool_name or "shell" in tool_name:
        return "bash"
    tool_input = event.get("tool_input")
    if isinstance(tool_input, dict) and "command" in tool_input:
        return "bash"
    if "command" in event:
        return "bash"
    return "all"


def field_value(field: str, event: dict[str, Any]) -> str:
    tool_input = event.get("tool_input")
    if isinstance(tool_input, dict) and field in tool_input:
        return str(tool_input[field])
    return str(event.get(field, ""))


def condition_matches(condition: dict[str, str], event: dict[str, Any]) -> bool:
    field = condition.get("field", "")
    operator = condition.get("operator", "contains")
    pattern = condition.get("pattern", "")
    value = field_value(field, event)

    if operator == "regex_match":
        return re.search(pattern, value, re.IGNORECASE) is not None
    if operator == "contains":
        return pattern.lower() in value.lower()
    if operator == "equals":
        return value == pattern
    if operator == "not_contains":
        return pattern.lower() not in value.lower()
    if operator == "starts_with":
        return value.startswith(pattern)
    if operator == "ends_with":
        return value.endswith(pattern)
    return False


def matching_rules(event: dict[str, Any]) -> list[dict[str, Any]]:
    active_event = event_name(event)
    matches: list[dict[str, Any]] = []
    for rule in load_rules():
        if rule.get("enabled") is False:
            continue
        rule_event = str(rule.get("event", "all")).lower()
        if rule_event not in {"all", active_event}:
            continue
        conditions = rule.get("conditions", [])
        if conditions and all(condition_matches(condition, event) for condition in conditions):
            matches.append(rule)
    return matches


def evaluate(event: dict[str, Any]) -> dict[str, Any]:
    matches = matching_rules(event)
    if not matches:
        return {}

    blocking = [rule for rule in matches if rule.get("action") == "block"]
    selected = blocking or matches
    message = "\n\n".join(str(rule.get("message") or rule.get("name")) for rule in selected)

    if blocking:
        if event_name(event) in {"stop", "before_stop"}:
            return {"decision": "block", "reason": message, "systemMessage": message}
        return {"decision": "deny", "systemMessage": message}
    return {"systemMessage": message}


def main() -> int:
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            event = {"raw": event}
        print(json.dumps(evaluate(event), ensure_ascii=False))
        return 0
    except Exception as exc:
        print(json.dumps({"systemMessage": f"hook error: {exc}"}, ensure_ascii=False))
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
