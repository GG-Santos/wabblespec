{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "{{ module_name }} Receipt",
  "description": "Phase completion receipt for {{ module_name }}. Machine-parseable gate artifact enforced by pre-tool-use hook.",
  "type": "object",
  "required": [
    "receipt_id",
    "module",
    "phase",
    "wave",
    "timestamp",
    "status",
    "checks_run",
    "checks_passed",
    "evidence"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "UUID for this receipt instance"
    },
    "module": {
      "type": "string",
      "const": "{{ module_name }}",
      "description": "Module that produced this receipt"
    },
    "phase": {
      "type": "string",
      "enum": ["research", "plan", "execute"],
      "description": "Framework phase during which receipt was produced"
    },
    "wave": {
      "type": "integer",
      "minimum": 1,
      "description": "Wave number within the current execute phase"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of receipt production"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PARTIAL"],
      "description": "PASS: all checks passed. FAIL: blocking check failed. PARTIAL: non-blocking failures present."
    },
    "checks_run": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Names of all checks executed, in order"
    },
    "checks_passed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Names of checks that passed — subset of checks_run"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "proof"],
        "properties": {
          "claim": {
            "type": "string",
            "description": "The assertion being evidenced"
          },
          "proof": {
            "type": "string",
            "description": "File path, command output, or observable fact that supports the claim"
          }
        },
        "additionalProperties": false
      },
      "description": "Evidence backing the status verdict. Each entry is one claim + proof pair."
    },
    "upstream_receipt_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "receipt_id values of receipts this receipt depends on. Hook validates these exist before allowing downstream phase."
    },
    "staleness_check": {
      "type": "object",
      "properties": {
        "evidence_ids_checked": {
          "type": "array",
          "items": { "type": "string" }
        },
        "all_fresh": { "type": "boolean" },
        "expired_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "description": "Optional. Present when the module read from memory drawers. Records staleness state at time of read."
    },
    "notes": {
      "type": "string",
      "description": "Optional freeform notes. Not machine-checked."
    }
  },
  "additionalProperties": false
}
