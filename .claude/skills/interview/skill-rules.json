{
  "module": "interview",
  "layer": "L1",
  "tier": 1,
  "activators": [
    "clarify requirements",
    "resolve ambiguity",
    "interview",
    "what do you mean",
    "/interview"
  ],
  "anti_activators": [
    "execution wave in progress",
    "intent.md exists and is FRESH with no unresolved dimensions"
  ],
  "phases": [
    "Research"
  ],
  "stages": [
    "P1"
  ],
  "authority": {
    "owns": [
      ".wabblespec/plans/intent.md"
    ],
    "reads": [
      ".wabblespec/plans/product-context.md",
      ".wabblespec/receipts/recipe-receipt.json"
    ]
  },
  "verification_mode": "Observation",
  "receipt_required": true,
  "collapse_eligible": false,
  "invariants": [
    "Max 3 questions per batch",
    "No leading questions",
    "Stop when ambiguity resolved \u2014 do not cover all dimensions unnecessarily",
    "Read product-context.md open questions before generating own questions",
    "Build target confirmation is first question when Recipe confidence < 0.8"
  ],
  "loading_gate": "stage",
  "commands": [
    "/interview"
  ],
  "file_path_patterns": []
}
