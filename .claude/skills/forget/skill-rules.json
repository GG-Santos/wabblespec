{
  "module": "forget",
  "layer": "L5",
  "tier": 2,
  "activators": [
    "delete drawer",
    "remove drawer",
    "forget this",
    "purge expired drawers",
    "bulk delete expired",
    "compliance deletion",
    "right to erasure",
    "gdpr erasure",
    "purge memory",
    "/forget"
  ],
  "anti_activators": [
    "mark expired",
    "transition staleness",
    "update drawer",
    "archive drawer"
  ],
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "ALL"
  ],
  "stages": [
    "ALL"
  ],
  "authority": {
    "owns": [
      ".wabblespec/state/memory/provenance/deletions/*.json"
    ],
    "reads": [
      ".wabblespec/state/memory/index.json",
      ".wabblespec/state/memory/wings/**/*.json",
      ".wabblespec/state/memory/closets/**/*.json"
    ],
    "deletes": [
      ".wabblespec/state/memory/wings/**/*.json",
      ".wabblespec/state/memory/closets/**/*.json"
    ],
    "notifies": [
      "entity-graph",
      "provenance"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false,
  "invariants": [
    "Provenance deletion record written BEFORE any drawer file is deleted",
    "Provenance records are never deleted \u2014 audit trail is permanent",
    "Compliance deletion requires legal_basis and compliance_reference",
    "FRESH/AGING drawers require force:true + compliance_reference to delete",
    "EntityGraph notified after every deletion to remove stale references"
  ],
  "produces": [
    "forget-receipt",
    "provenance-deletion-records"
  ],
  "depends_on": [
    "memory",
    "provenance",
    "entity-graph"
  ],
  "loading_gate": "activation",
  "commands": [
    "/forget"
  ],
  "file_path_patterns": []
}
