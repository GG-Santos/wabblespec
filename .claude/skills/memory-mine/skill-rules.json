{
  "module": "memory-mine",
  "layer": "L5",
  "tier": 2,
  "activators": [
    "run memory mine",
    "mine memory",
    "analyze memory store",
    "gap detection",
    "find memory gaps",
    "cluster drawers",
    "pattern extraction",
    "staleness map",
    "memory analysis",
    "/memory-mine"
  ],
  "anti_activators": [
    "execution in progress",
    "wave in progress",
    "executor is running",
    "fewer than 50 drawers"
  ],
  "preconditions": [
    "No active execution wave",
    "drawer count >= 50"
  ],
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "between-sessions"
  ],
  "stages": [
    "offline"
  ],
  "authority": {
    "owns": [
      ".wabblespec/state/memory/mine/gap-map.md",
      ".wabblespec/state/memory/mine/mine-clusters.md",
      ".wabblespec/state/memory/mine/pattern-summary.md",
      ".wabblespec/state/memory/mine/staleness-map.md"
    ],
    "reads": [
      ".wabblespec/state/memory/index.json",
      ".wabblespec/state/memory/wings/**/*.json",
      "modules/l5/memory/rules/staleness-thresholds.md"
    ],
    "notifies": []
  },
  "verification_mode": "Observation",
  "receipt_required": true,
  "collapse_eligible": false,
  "invariants": [
    "MemoryMine never runs during active execution \u2014 hard block",
    "MemoryMine never writes drawers \u2014 analysis files only",
    "Gap-map items are signals not tasks \u2014 Dream decides which to pursue",
    "Minimum 50 drawers before meaningful cluster detection"
  ],
  "produces": [
    "mine-receipt",
    "gap-map.md",
    "mine-clusters.md",
    "pattern-summary.md",
    "staleness-map.md"
  ],
  "loading_gate": "activation",
  "commands": [
    "/mine"
  ],
  "file_path_patterns": []
}
