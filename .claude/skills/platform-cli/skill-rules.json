{
  "layer": "L3",
  "invariants": [
    "CLI platform only activates when Recipe has run and identified CLI as primary target",
    "Language module must be loaded before spec template is populated",
    "verification/gates.md must be registered with Verifier before any Executor wave runs",
    "Platform activation receipt must be written before Specify begins"
  ],
  "produces": [
    "platform-activation-receipt"
  ],
  "loads": [
    "spec-template/design-document.md",
    "spec-template/systems-design.md",
    "spec-template/technical-spec.md",
    "engineering/build-toolchain.md",
    "engineering/performance-budgets.md",
    "security/threat-model.md",
    "security/platform-controls.md",
    "verification/gates.md"
  ],
  "routes_to_language_modules": [
    ".wabblespec/engine/shared/dev/languages/node",
    ".wabblespec/engine/shared/dev/languages/python",
    ".wabblespec/engine/shared/dev/languages/go",
    ".wabblespec/engine/shared/dev/languages/rust"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [
    "**/bin/**",
    "**/cmd/**",
    "**/*.sh",
    "**/*.ps1",
    "cli.py",
    "**/cli/**/*.py",
    "**/cmd/**/*.go"
  ],
  "module": "cli",
  "activators": [
    "cli tool",
    "command line tool",
    "terminal tool",
    "command-line application",
    "binary distribution",
    "npm global package"
  ],
  "anti_activators": [
    "index.html",
    "pages/",
    "components/",
    "server.ts",
    "app.py with Flask/FastAPI",
    "Dockerfile with EXPOSE"
  ],
  "tier": 2,
  "build_targets": [
    "CLI"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/cli-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/",
      ".wabblespec/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
