{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provenance Record",
  "description": "Lineage record for one drawer. Stored in provenance/index.json keyed by drawer_id.",
  "type": "object",
  "required": [
    "drawer_id", "topic", "source", "written_by", "written_at",
    "confidence", "staleness_state", "cited_by", "contradiction_with", "deletion"
  ],
  "properties": {
    "drawer_id": { "type": "string" },
    "topic": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["path", "type", "trust_level"],
      "properties": {
        "path": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["framework-reference", "project-file", "external-doc", "internal-computation"]
        },
        "trust_level": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"]
        }
      }
    },
    "written_by": { "type": "string", "description": "Module ID." },
    "written_at": { "type": "string", "format": "date-time" },
    "last_updated": { "type": ["string", "null"], "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "staleness_state": {
      "type": "string",
      "enum": ["FRESH", "AGING", "STALE", "EXPIRED", "NEEDS_REVERIFICATION", "SUPERSEDED"]
    },
    "last_verified": { "type": ["string", "null"], "format": "date-time" },
    "superseded_by": { "type": ["string", "null"] },
    "source_hash": {
      "type": ["string", "null"],
      "description": "SHA-256 hex of source content at write time. Populated when source.type is project-file or framework-reference. Null for internal-computation sources. Enables change detection: if current hash differs from stored hash, drawer is a cascade candidate.",
      "pattern": "^[0-9a-f]{64}$|^$"
    },
    "cited_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Spec artifact paths that reference this drawer."
    },
    "cascade_events": {
      "type": "array",
      "description": "History of cascade events that affected this drawer. Append-only.",
      "items": {
        "type": "object",
        "required": ["triggered_at", "change_class", "source_spec", "hop_depth", "affected_specs"],
        "properties": {
          "triggered_at": { "type": "string", "format": "date-time" },
          "change_class": {
            "type": "string",
            "enum": ["BREAKING", "NON_BREAKING", "ADDITIVE"],
            "description": "BREAKING: cascades NEEDS_REVERIFICATION. NON_BREAKING: logged only. ADDITIVE: no cascade."
          },
          "source_spec": { "type": "string", "description": "Spec path that changed and triggered this cascade." },
          "hop_depth": { "type": "integer", "minimum": 1, "maximum": 2 },
          "affected_specs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Spec artifact paths marked NEEDS_REVERIFICATION at hop 2 of this cascade event."
          }
        }
      }
    },
    "contradiction_with": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Drawer IDs this record contradicts."
    },
    "deletion": {
      "type": "object",
      "required": ["deleted"],
      "properties": {
        "deleted": { "type": "boolean" },
        "deleted_at": { "type": ["string", "null"], "format": "date-time" },
        "deleted_by": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "archived_to": { "type": ["string", "null"] }
      }
    }
  }
}
