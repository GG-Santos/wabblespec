{
  "layer": "L4",
  "invariants": [
    "Gateway activates only after L3 platform package has written its activation receipt",
    "Gateway gates supplement platform gates — they do not replace them",
    "Coverage floor must be declared in design-document before quality-gates.md is registered",
    "Dependency freshness check covers all direct dependencies, not just devDependencies"
  ],
  "produces": [
    "gateway-engineering-receipt"
  ],
  "loads": [
    "build-standards.md",
    "code-quality.md",
    "dependency-standards.md",
    "quality-gates.md"
  ],
  "supplements": [
    "modules/l3/cli/engineering/",
    "modules/l3/web/engineering/",
    "modules/l3/api-service/engineering/"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [],
  "module": "engineering",
  "activators": [
    "code quality",
    "engineering standards",
    "CI pipeline",
    "test coverage",
    "technical debt",
    "production readiness",
    "code review",
    "documentation"
  ],
  "anti_activators": [],
  "tier": 2,
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/engineering-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/",
      ".wabblespec/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
