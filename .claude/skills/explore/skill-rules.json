{
  "module": "explore",
  "layer": "L1",
  "tier": 1,
  "activators": [
    "explore codebase",
    "map project",
    "project discovery",
    "codebase map",
    "/explore"
  ],
  "anti_activators": [
    "execution wave in progress",
    "project-map.md exists and is FRESH"
  ],
  "phases": [
    "Research"
  ],
  "stages": [
    "ALL"
  ],
  "authority": {
    "owns": [
      ".wabblespec/plans/project-map.md"
    ],
    "reads": [
      "project/repo/**/*"
    ],
    "notifies": [
      "EntityGraph",
      "ResearchLog"
    ]
  },
  "verification_mode": "Observation",
  "receipt_required": true,
  "collapse_eligible": false,
  "invariants": [
    "Traverse from high-value nodes \u2014 do not scan entire repo",
    "One Memory drawer per distinct finding \u2014 not per file",
    "Never runs during active execution waves",
    "Gaps declared explicitly \u2014 do not block on incomplete traversal",
    "EntityGraph notified after all drawers written"
  ],
  "loading_gate": "stage",
  "commands": [
    "/explore"
  ],
  "file_path_patterns": []
}
