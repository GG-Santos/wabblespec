{
  "module": "package",
  "layer": "L7",
  "tier": 1,
  "activators": [
    "package artifact",
    "sign artifact",
    "build release package",
    "create release artifact",
    "sign docker image",
    "sign binary",
    "publish package",
    "package for release",
    "/package"
  ],
  "anti_activators": [
    "delivery receipt missing",
    "archive not run",
    "execution still in progress"
  ],
  "preconditions": [
    "delivery-receipt-*.json exists in .wabblespec/receipts/",
    "Signing key available in CI secrets"
  ],
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "Deliver"
  ],
  "stages": [
    "post-execution"
  ],
  "authority": {
    "owns": [
      ".wabblespec/artifacts/manifest-*.json",
      ".wabblespec/receipts/package-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/receipts/delivery-receipt-*.json",
      ".wabblespec/VERSION",
      "dist/**/*"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false,
  "invariants": [
    "Signing failure is a hard error \u2014 pipeline stops, no unsigned artifact produced",
    "SHA-256 hash recorded for every artifact in manifest",
    "Package does not run without delivery receipt from Archive",
    "Signing key material never appears in manifest or receipt \u2014 key ID only",
    "Provenance chain links artifact to git commit and CI build"
  ],
  "produces": [
    "package-receipt",
    "artifact-manifest"
  ],
  "depends_on": [
    "archive"
  ],
  "consumed_by": [
    "deploy",
    "release"
  ],
  "loading_gate": "phase",
  "commands": [],
  "file_path_patterns": []
}
