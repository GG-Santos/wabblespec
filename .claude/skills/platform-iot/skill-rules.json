{
  "layer": "L3",
  "invariants": [
    "Flash budget must be declared and verified at build time before Specify receipt",
    "RAM budget must be declared with stack + heap + static allocation breakdown",
    "OTA signing strategy must be declared before any Executor wave begins",
    "Watchdog timer strategy must be declared before Specify receipt",
    "Fail-safe behavior on power loss must be declared",
    "Platform activation receipt must be written before Specify begins"
  ],
  "produces": [
    "platform-activation-receipt"
  ],
  "loads": [
    "spec-template/design-document.md",
    "spec-template/systems-design.md",
    "spec-template/technical-spec.md",
    "engineering/build-toolchain.md",
    "engineering/performance-budgets.md",
    "security/threat-model.md",
    "security/platform-controls.md",
    "verification/gates.md"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [
    "**/*.c",
    "**/*.cpp",
    "**/firmware/**",
    "**/CMakeLists.txt",
    "**/*.ld",
    "src/**/*.c",
    "src/**/*.cpp",
    "src/**/*.rs",
    "include/**/*.h",
    "platformio.ini",
    "sdkconfig"
  ],
  "module": "iot",
  "activators": [
    "firmware",
    "embedded",
    "iot",
    "microcontroller",
    "mcu",
    "rtos",
    "freertos",
    "zephyr",
    "arduino",
    "esp32",
    "stm32",
    "raspberry pi pico",
    "bare metal",
    "embedded c",
    "embedded rust",
    "real-time system",
    "ota firmware",
    "connected device",
    "edge device"
  ],
  "anti_activators": [],
  "tier": 2,
  "build_targets": [
    "IOT"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/state/receipts/iot-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/state/plans/",
      ".wabblespec/state/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
