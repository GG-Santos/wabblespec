{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deps Receipt Extension",
  "description": "Extends receipt.base.schema.json. Module-specific fields for the Deps module.",
  "allOf": [
    { "$ref": "../../../.wabblespec/engine/shared/schemas/receipt.base.schema.json" }
  ],
  "properties": {
    "deps_scanned": {
      "type": "integer",
      "minimum": 0,
      "description": "Total dependencies found across all manifest files."
    },
    "risk_summary": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      },
      "required": ["critical", "high", "medium", "low", "unknown"]
    },
    "outdated_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of dependencies classified OUTDATED or CRITICAL_OUTDATED."
    },
    "license_violations": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of INCOMPATIBLE licenses in direct dependencies."
    },
    "sbom_path": {
      "type": "string",
      "description": "Path to SBOM artifact. e.g. .wabblespec/deps/sbom-<timestamp>.json"
    },
    "supply_chain_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["package", "reason"]
      },
      "description": "Packages with supply chain concerns."
    }
  },
  "required": [
    "deps_scanned",
    "risk_summary",
    "outdated_count",
    "license_violations",
    "sbom_path",
    "supply_chain_flags"
  ]
}
