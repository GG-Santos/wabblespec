{
  "layer": "L6",
  "invariants": [
    "Every drawer written by Research Log must have a source in the evidence field",
    "Research Log checks MemorySearch before writing to avoid duplicate drawers",
    "Confidence must reflect actual evidence quality — not defaulted to 1.0",
    "Research Log writes a receipt confirming all drawers were persisted"
  ],
  "produces": [
    "research-log-receipt",
    "memory-drawers"
  ],
  "consumes": [
    ".wabblespec/engine/shared/schemas/drawer.schema.json"
  ],
  "depends_on": [
    "memory"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [],
  "module": "research-log",
  "activators": [
    "log this finding",
    "save this research",
    "remember this for later",
    "log to memory",
    "research log",
    "add to knowledge base"
  ],
  "anti_activators": [],
  "tier": 3,
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "ALL"
  ],
  "authority": {
    "owns": [
      ".wabblespec/state/receipts/research-log-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/state/plans/",
      ".wabblespec/state/receipts/"
    ]
  },
  "verification_mode": "Observation",
  "receipt_required": true,
  "collapse_eligible": false
}
