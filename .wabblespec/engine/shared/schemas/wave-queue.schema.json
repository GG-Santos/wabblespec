{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WabbleSpec Wave Queue",
  "description": "Schema for .wabblespec/state/queue/wave-queue.json produced by wave-queue.py. File-locked parallel wave task queue.",
  "type": "object",
  "required": ["schema_version", "session_id", "created_at", "tasks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1],
      "description": "Queue schema version. Currently 1."
    },
    "session_id": {
      "type": "string",
      "description": "Session this queue belongs to."
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 timestamp when queue was created."
    },
    "tasks": {
      "type": "array",
      "description": "Wave task entries.",
      "items": {
        "type": "object",
        "required": ["task_id", "session_id", "wave_number", "wave_label", "status"],
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Unique task identifier (wave-N-session_id)."
          },
          "session_id": {
            "type": "string"
          },
          "wave_number": {
            "type": "integer",
            "minimum": 1
          },
          "wave_label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "CLAIMED", "PASS", "FAIL"],
            "description": "Task lifecycle state."
          },
          "worker_id": {
            "type": ["string", "null"],
            "description": "ID of worker that claimed this task. Null when PENDING."
          },
          "claimed_at": {
            "type": ["string", "null"],
            "description": "ISO-8601 timestamp when claimed. Null when PENDING."
          },
          "completed_at": {
            "type": ["string", "null"],
            "description": "ISO-8601 timestamp when completed. Null until done."
          },
          "receipt_path": {
            "type": ["string", "null"],
            "description": "Path to wave receipt. Null until completed."
          },
          "failure_reason": {
            "type": ["string", "null"],
            "description": "Failure description. Null unless status=FAIL."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
