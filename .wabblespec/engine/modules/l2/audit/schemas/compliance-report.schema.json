{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compliance Report",
  "description": "Detailed audit findings written to .wabblespec/audits/compliance-<timestamp>.md (as JSON for structured consumers).",
  "type": "object",
  "properties": {
    "generated": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "description": "Files or artifacts audited." },
    "dimensions": {
      "type": "object",
      "properties": {
        "wcag": {
          "type": "object",
          "properties": {
            "level_achieved": { "type": "string", "enum": ["AA", "AAA", "PARTIAL", "FAIL", "not-applicable"] },
            "gates_checked": { "type": "integer" },
            "gates_passed": { "type": "integer" },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion": { "type": "string" },
                  "location": { "type": "string" },
                  "description": { "type": "string" },
                  "severity": { "type": "string", "enum": ["minor", "major", "critical"] }
                },
                "required": ["criterion", "description"]
              }
            }
          }
        },
        "gdpr": {
          "type": "object",
          "properties": {
            "violations": { "type": "integer" },
            "findings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "license": {
          "type": "object",
          "properties": {
            "violations": { "type": "integer" },
            "incompatible_deps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "guard_log": {
          "type": "object",
          "properties": {
            "logs_consumed": { "type": "boolean" },
            "violations_found": { "type": "integer" },
            "critical_triggers": { "type": "integer" },
            "findings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "attestation_required": { "type": "boolean" },
    "attestation_items": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific items requiring human sign-off."
    }
  },
  "required": ["generated", "scope", "dimensions", "attestation_required"]
}
