{
  "layer": "L4",
  "invariants": [
    "Gateway activates only after Design gateway has written its activation receipt",
    "User research must be declared in scope at P1 — gateway does not auto-activate",
    "All research participants must provide informed consent before participation",
    "No participant PII in Memory drawers — anonymize before writing",
    "Uncompensated high-effort participation is not acceptable",
    "Research artifacts written to Memory as FRESH drawers after every research cycle"
  ],
  "produces": [
    "gateway-experience-receipt"
  ],
  "loads": [
    "user-research.md",
    "usability-testing.md",
    "accessibility-deep-dive.md",
    "satisfaction-measurement.md",
    "research-ethics.md",
    "audit-gates.md"
  ],
  "supplements": [
    "modules/l4/design/",
    "modules/l4/aesthetic/"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [],
  "module": "experience",
  "activators": [
    "user research",
    "usability testing",
    "accessibility audit",
    "screen reader",
    "color blindness",
    "SUS",
    "NPS",
    "satisfaction",
    "research ethics",
    "usability test",
    "/experience"
  ],
  "anti_activators": [],
  "tier": 2,
  "build_targets": [
    "ALL"
  ],
  "phases": [
    "Research",
    "Plan",
    "Execute"
  ],
  "authority": {
    "owns": [
      ".wabblespec/receipts/experience-receipt-*.json"
    ],
    "reads": [
      ".wabblespec/plans/",
      ".wabblespec/receipts/"
    ]
  },
  "verification_mode": "Audit",
  "receipt_required": true,
  "collapse_eligible": false
}
