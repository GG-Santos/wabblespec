  "supplements": [
    "modules/l3/web/",
    "modules/l3/desktop/",
    "modules/l3/mobile/",
    "modules/l3/game/",
    "modules/l3/extension/"
  ],
  "loading_gate": "activation",
  "commands": [],
  "file_path_patterns": [],
  "module": "aesthetic",
  "activators": [
    "visual design",
    "brand",
    "color system",
    "typography",
    "motion",
    "design tokens",
    "dark mode",
    "contrast",
    "font loading",
    "reduced motion",
    "/aesthetic"
  ],
  "anti_activators": [],
  "tier": 2,
