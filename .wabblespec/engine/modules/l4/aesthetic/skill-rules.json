{
  "layer": "L4",
  "invariants": [
    "Gateway activates only after L3 platform package has written its activation receipt",
    "No raw color, spacing, or visual values in component code — token references only",
    "WCAG AA contrast minimums cannot be waived",
    "prefers-reduced-motion must be respected — no exceptions",
