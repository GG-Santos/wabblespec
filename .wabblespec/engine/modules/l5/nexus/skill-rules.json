{
  "module": "nexus",
  "layer": "L5",
  "tier": 2,
  "activators": ["/nexus", "why query", "blast radius", "what changed", "cross-module context", "graph query"],
  "authority": {
    "owns": [".wabblespec/receipts/nexus-receipt-*.json", ".wabblespec/nexus/response-*.json"],
    "reads": [
      "modules/l5/nexus/rules/nexus-vs-explore.md",
      "modules/l5/nexus/rules/query-types.md"
    ]
  },
  "verification_mode": "Observation",
  "receipt_required": true,
  "preconditions": ["Memory has >= 10 drawers", "entity-graph.json exists"],
  "invariants": [
    { "id": "NXS-1", "rule": "Every claim in response must be backed by a drawer or graph edge", "severity": "BLOCKING" },
    { "id": "NXS-2", "rule": "Graph freshness must be checked before any query", "severity": "BLOCKING" },
    { "id": "NXS-3", "rule": "Node drawer_id references required for Nexus entity backing (D6)", "severity": "BLOCKING" }
  ],
  "rules": [
    "rules/nexus-vs-explore.md",
    "rules/query-types.md"
  ],
  "receipt_schema": "schemas/nexus-receipt.schema.json"
}
