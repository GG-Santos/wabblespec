{
  "module": "ground",
  "layer": "L0",
  "tier": 1,
  "activators": ["/ground", "ground check", "verify task card", "pre-execution check"],
  "authority": {
    "owns": [".wabblespec/receipts/ground-receipt.json"],
    "reads": [
      ".wabblespec/plans/task-card.md",
      ".wabblespec/plans/wave-plan.md",
      "project/repo/**"
    ]
  },
  "verification_mode": "observation",
  "receipt_required": true,
  "activation": {
    "triggers": [
      { "signal": "executor_wave_1_about_to_run", "condition": "task_complexity in [Medium, High] AND ground_receipt absent" },
      { "signal": "explicit_command", "pattern": "/ground" },
      { "signal": "recipe_target", "targets": ["ai-agent", "data-pipeline"], "condition": "always" }
    ],
    "inhibitors": [
      "task_card.change_class == COSMETIC",
      "scope_level == L0",
      "ground_receipt.status == PASS AND ground_receipt.task_card_hash == current_task_card_hash"
    ]
  },
  "never_writes": [
    "project/repo/**",
    ".wabblespec/plans/**",
    ".wabblespec/memory/**"
  ],
  "blocks_on": ["BLOCK"],
  "passes_through_on": ["PASS", "PARTIAL"]
}
