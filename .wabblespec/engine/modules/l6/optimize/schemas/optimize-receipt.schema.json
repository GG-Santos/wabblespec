{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "optimize-receipt.schema.json",
  "title": "OptimizeReceipt",
  "allOf": [{ "$ref": "../../../.wabblespec/engine/shared/schemas/receipt.base.schema.json" }],
  "properties": {
    "modes_run": {
      "type": "array",
      "items": { "enum": ["seo", "ai-search", "structured-data", "performance", "social", "local", "video", "voice"] }
    },
    "target_path": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mode", "priority", "issue", "fix_applied"],
        "properties": {
          "mode": { "type": "string" },
          "priority": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "issue": { "type": "string" },
          "fix_applied": { "type": "boolean" },
          "fix_description": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "total_findings": { "type": "integer", "minimum": 0 },
    "critical_count": { "type": "integer", "minimum": 0 },
    "fixes_applied": { "type": "integer", "minimum": 0 },
    "verdict": { "enum": ["PASS", "WARN", "FAIL"] },
    "optimized_at": { "type": "string", "format": "date-time" }
  },
  "required": ["modes_run", "target_path", "findings", "total_findings", "critical_count", "fixes_applied", "verdict", "optimized_at"]
}
