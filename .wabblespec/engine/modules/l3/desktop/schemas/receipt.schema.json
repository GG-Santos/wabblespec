{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WabbleSpec Desktop Platform Receipt",
  "description": "Extends base receipt schema for Desktop platform activation and gate verification.",
  "allOf": [
    { "$ref": "../../../../.wabblespec/engine/shared/schemas/receipt.base.schema.json" }
  ],
  "properties": {
    "platform_target": {
      "type": "string",
      "const": "desktop",
      "description": "Fixed: desktop"
    },
    "framework": {
      "type": "string",
      "enum": ["electron", "tauri", "swift-native", "dotnet-native", "qt", "other"],
      "description": "Desktop framework detected by Recipe"
    },
    "os_targets": {
      "type": "array",
      "items": { "type": "string", "enum": ["macos", "windows", "linux"] },
      "description": "Operating systems targeted for distribution"
    },
    "code_signing_declared": {
      "type": "boolean",
      "description": "Code signing strategy declared in design-document.md"
    },
    "auto_updater_declared": {
      "type": "boolean",
      "description": "Auto-updater mechanism declared and configured"
    },
    "ipc_security_declared": {
      "type": "boolean",
      "description": "IPC security model (contextBridge, preload script) declared"
    },
    "node_integration_disabled": {
      "type": "boolean",
      "description": "Electron: nodeIntegration: false in BrowserWindow (required for security)"
    },
    "spec_template_variant": {
      "type": "string",
      "const": "desktop",
      "description": "Fixed: desktop"
    },
    "verification_gates_passed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Gate IDs that passed"
    },
    "verification_gates_failed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Gate IDs that failed. Must be empty before Delivery wave."
    }
  },
  "required": [
    "platform_target",
    "framework",
    "os_targets",
    "code_signing_declared",
    "spec_template_variant",
    "verification_gates_passed",
    "verification_gates_failed"
  ]
}
