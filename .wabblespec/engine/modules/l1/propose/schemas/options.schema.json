{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Options Document Header",
  "description": "Frontmatter fields for .wabblespec/options-<stage>-<timestamp>.md",
  "type": "object",
  "required": ["stage", "target", "generated_at", "recommendation"],
  "properties": {
    "stage": {
      "type": "string",
      "enum": ["P1", "P2", "P3", "P4"],
      "description": "Spec stage at which options were generated"
    },
    "target": {
      "type": "string",
      "description": "Build target from Recipe"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "recommendation": {
      "type": "string",
      "description": "Option number and brief rationale — e.g. 'Option 2 — lowest risk given current scope'"
    },
    "decision_point": {
      "type": "string",
      "description": "What question is being decided"
    },
    "option_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "reviewer_triggered": {
      "type": "boolean",
      "description": "Whether Reviewer was consulted before selection"
    },
    "selected_option": {
      "type": "integer",
      "description": "Option number chosen — written after selection"
    },
    "selection_method": {
      "type": "string",
      "enum": ["user", "reviewer", "auto-recommendation"],
      "description": "Who made the selection"
    }
  }
}
