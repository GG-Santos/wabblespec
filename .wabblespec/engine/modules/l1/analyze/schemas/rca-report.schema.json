{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCA Report",
  "description": "Structured RCA output written to .wabblespec/analysis/rca-<timestamp>.md (as JSON). Human-readable report is the primary output; this schema governs the structured fields.",
  "type": "object",
  "properties": {
    "generated": { "type": "string", "format": "date-time" },
    "problem_statement": { "type": "string" },
    "method": { "type": "string", "enum": ["5-whys", "fishbone", "fault-tree", "timeline"] },
    "root_cause": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence_tier": { "type": "string", "enum": ["verified", "probable", "speculative"] },
        "evidence_sources": { "type": "array", "items": { "type": "string" } },
        "verification_test": { "type": ["string", "null"], "description": "Test or check that would confirm or refute this root cause." }
      },
      "required": ["summary", "confidence", "evidence_tier", "evidence_sources"]
    },
    "contributing_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factor": { "type": "string" },
          "category": { "type": "string", "description": "For fishbone: People/Process/Technology/Environment/Data/External. For others: free text." },
          "evidence": { "type": "string" }
        },
        "required": ["factor"]
      }
    },
    "method_trace": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Step-by-step trace of the method. For 5-whys: each why and answer. For timeline: ordered events."
    },
    "nexus_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "drawer_id": { "type": "string" },
          "topic": { "type": "string" },
          "relevance": { "type": "string" }
        }
      },
      "description": "Drawers returned by Nexus query. Empty array if nexus not queried."
    }
  },
  "required": ["generated", "problem_statement", "method", "root_cause"]
}
