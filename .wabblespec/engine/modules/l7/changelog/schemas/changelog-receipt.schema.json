{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "changelog-receipt.schema.json",
  "title": "ChangelogReceipt",
  "allOf": [{ "$ref": "../../../.wabblespec/engine/shared/schemas/receipt.base.schema.json" }],
  "properties": {
    "version": { "type": "string" },
    "from_ref": { "type": "string" },
    "to_ref": { "type": "string" },
    "commits_parsed": { "type": "integer", "minimum": 0 },
    "commits_included": { "type": "integer", "minimum": 0 },
    "commits_excluded": { "type": "integer", "minimum": 0 },
    "skipped_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha", "subject", "reason"],
        "properties": {
          "sha": { "type": "string" },
          "subject": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "object",
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "deprecated": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "fixed": { "type": "integer", "minimum": 0 },
        "security": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "output_path": { "type": "string" },
    "format": { "enum": ["keepachangelog", "github-releases", "plain"] },
    "verdict": { "enum": ["PASS", "WARN"] },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["version", "from_ref", "to_ref", "commits_parsed", "commits_included", "commits_excluded", "skipped_commits", "sections", "output_path", "format", "verdict", "generated_at"]
}
